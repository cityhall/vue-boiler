# API
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# Auth / SSO (align with Vue 2 cookie contract)
VITE_SSO_AUTHORIZE_URL=https://sso.example.internal/oauth/authorize
VITE_SSO_CLIENT_ID=app-web
VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/sso/callback
VITE_ACCESS_COOKIE=access_token
VITE_REFRESH_COOKIE=refresh_token

# Realtime Performance Testing
VITE_STOMP_URL=wss://stomp.example.internal/ws
VITE_STOMP_VHOST=/
VITE_REALTIME_V3_ENABLED=false

# Feature flags (comma-separated enabled flags)
VITE_FEATURE_FLAGS=catalog_v3_enabled
